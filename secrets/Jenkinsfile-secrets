pipeline {
    agent any
    environment {
        VAULT_ADDR = 'http://127.0.0.1:8200'
    }
    stages {
        stage('Fetch Secrets from Vault') {
            steps {
                withCredentials([string(credentialsId: 'vault-ci-token', variable: 'VAULT_TOKEN')]) {
                    sh '''
                        set +x
                        SECRET_JSON=$(curl -s -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/secret/data/lab4/app")
                        API_KEY=$(echo "$SECRET_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['data']['data']['api_key'])")
                        echo "Fetched secret from Vault (length=${#API_KEY}, value=****MASKED****)"
                    '''
                }
            }
        }
    }
}
